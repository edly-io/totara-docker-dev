#!/bin/bash
#
# tcomposer — Composer wrapper that safely toggles Docker overlay volumes per-site per-plugin.
#
# For typical Packagist packages (no overlay mounts), this just runs Composer in
# the chosen PHP container — no overlay edits and no container recreation.
#
# When Docker bind-mounts overlay a private-repo plugin's Composer install paths,
# running composer remove/require/update inside the container would delete or
# conflict with the source files on the host. For those packages this script:
#   1. Comments out the overlay lines for the plugin+site in totara-composer.yml
#   2. Recreates the affected containers (so the overlay is gone)
#   3. Runs the Composer command (now operating on the real dist copy, not the mount)
#   4. Restores the overlay lines and recreates containers (require/update only)
#
# Usage (run from within a Totara site directory):
#   cd ~/projects/totara-sites/demo-totara-txp
#   tcomposer php-8.4 remove edly-io/local_todo
#   tcomposer php-8.3 require edly-io/local_todo:^1.0
#   tcomposer php-8.4 update edly-io/local_todo
#   tcomposer php-8.4 install                                   (site-wide; Composer only, no overlays)
#   tcomposer php-8.4 require edly-io/local_todo:^1.0 --no-dev   (extra args passed through)
#   tcomposer php-8.4 require monolog/monolog                   (Packagist: Composer only)
#   tcomposer php remove edly-io/local_todo   (php / php-debug auto-picks a site-compatible container, same as texec, but its better to be explicit about the version of PHP)
#
# Place in : ~/projects/totara-docker-dev/custom/
# Activate : chmod +x ~/projects/totara-docker-dev/custom/tcomposer
# Optional  : add totara-docker-dev/custom/ to your $PATH in ~/.zshrc

# ── Standard docker-dev path boilerplate ──────────────────────────────────────
script_path="$( cd "$(dirname "$0")" ; pwd -P )"
project_path="$( cd "$script_path" && cd ..; pwd -P )"
set -a; source "$project_path/.env"; set +a
bin="$project_path/bin"

OVERLAY_FILE="$script_path/totara-composer.yml"

# ── Validate arguments ────────────────────────────────────────────────────────
PHP_CONTAINER="${1:-}"
OPERATION="${2:-}"

if [[ -z "$PHP_CONTAINER" || -z "$OPERATION" ]]; then
    echo "Usage: tcomposer <php-container> <install|require|remove|update> [vendor/package] [extra composer args...]"
    echo "       e.g. tcomposer php-8.4 install"
    echo "            tcomposer php-8.4 require edly-io/local_todo:^1.0"
    echo "       Must be run from within a Totara site directory."
    exit 1
fi

if [[ "$PHP_CONTAINER" != php* ]]; then
    echo "Error: first argument must be a PHP container (e.g. php-8.4, php-8.3, php-8.4-debug, or php)."
    exit 1
fi

# require / remove / update operate on one package (and may need overlay handling).
# install and other Composer commands have no package and never touch overlays.
PACKAGE=""
if [[ "$OPERATION" == "require" || "$OPERATION" == "remove" || "$OPERATION" == "update" ]]; then
    PACKAGE="${3:-}"
    if [[ -z "$PACKAGE" ]]; then
        echo "Error: '${OPERATION}' requires a package argument (vendor/package)."
        echo "       e.g. tcomposer php-8.4 ${OPERATION} edly-io/local_todo"
        exit 1
    fi
    shift 3
else
    shift 2
fi
EXTRA_ARGS=("$@")   # any remaining args are passed straight through to Composer

# ── Derive site name from current working directory ───────────────────────────
# Strips LOCAL_SRC prefix from PWD, then takes the first path segment.
# e.g. PWD=/Users/me/projects/totara-sites/demo-totara-txp → demo-totara-txp
sub_path="${PWD//$LOCAL_SRC/}"
SITE_NAME="${sub_path#/}"
SITE_NAME="${SITE_NAME%%/*}"

if [[ -z "$SITE_NAME" ]] || [[ ! -f "$LOCAL_SRC/$SITE_NAME/composer.json" ]]; then
    echo "Error: tcomposer must be run from within a Totara site directory."
    echo "       Could not determine site name from PWD: $PWD"
    exit 1
fi

# If just 'php' or 'php-debug' is specified, resolve the site-compatible container (same as texec).
if [[ "$PHP_CONTAINER" == "php" || "$PHP_CONTAINER" == "php-debug" ]]; then
    php_container=($(php "$bin/helpers/php_container.php" "$LOCAL_SRC/$SITE_NAME"))
    if [[ "$PHP_CONTAINER" == "php-debug" ]]; then
        PHP_CONTAINER="${php_container[0]}-debug"
    else
        PHP_CONTAINER="${php_container[0]}"
    fi
    echo "[tcomposer] Using PHP container: ${PHP_CONTAINER}"
fi

_run_composer() {
    if [[ -n "$PACKAGE" ]]; then
        texec "$PHP_CONTAINER" composer "${OPERATION}" "${PACKAGE}" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    else
        texec "$PHP_CONTAINER" composer "${OPERATION}" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    fi
}

# Site-wide Composer commands (install, dump-autoload, …) never toggle overlays.
if [[ -z "$PACKAGE" ]]; then
    echo "[tcomposer] Running Composer only (${OPERATION})."
    echo ""
    _run_composer
    exit $?
fi

# ── Containers that carry overlay volumes ─────────────────────────────────────
CONTAINERS=("$PHP_CONTAINER" nodejs nginx)

# ── Derive plugin short-name from package argument ────────────────────────────
# e.g. edly-io/local_todo → local_todo
PLUGIN_NAME="${PACKAGE%%:*}"   # strip any :version constraint first
PLUGIN_NAME="${PLUGIN_NAME##*/}"

# ── Pattern that scopes changes to THIS plugin in THIS site only ──────────────
# Each volume line looks like:
#   - ${HOME}/.../totara-custom-plugins/local_todo:${REMOTE_SRC}/demo-totara-txp/server/local/todo
#                                       ↑ plugin name              ↑ site name
# Anchor on the custom-plugins directory so a Packagist package named e.g. "todo"
# cannot match an overlay for "local_todo".
PATTERN="totara-custom-plugins/${PLUGIN_NAME}[/:].*${SITE_NAME}"

# ── Helper functions ──────────────────────────────────────────────────────────
_comment_overlays() {
    sed -i.bak "/${PATTERN}/s|^      - |      # - |" "$OVERLAY_FILE"
    rm -f "${OVERLAY_FILE}.bak"
    echo "[tcomposer] Overlays disabled  : '${PLUGIN_NAME}' in '${SITE_NAME}'"
}

_restore_overlays() {
    sed -i.bak "/${PATTERN}/s|^      # - |      - |" "$OVERLAY_FILE"
    rm -f "${OVERLAY_FILE}.bak"
    echo "[tcomposer] Overlays restored  : '${PLUGIN_NAME}' in '${SITE_NAME}'"
}

_recreate_containers() {
    echo "[tcomposer] Recreating containers: ${CONTAINERS[*]}"
    # tup detects the YAML change and recreates affected containers automatically.
    "$bin/tup" "${CONTAINERS[@]}"
}

_abort() {
    # Disable trap to prevent recursion if restore/recreate also errors.
    trap - ERR INT TERM
    echo ""
    echo "[tcomposer] Interrupted — restoring overlays and recreating containers..."
    _restore_overlays
    _recreate_containers
    echo "[tcomposer] State restored. Exiting."
    exit 1
}

# ── Packagist / no-overlay path: Composer only, no container recreation ──────
if ! grep -q "$PATTERN" "$OVERLAY_FILE"; then
    echo "[tcomposer] No overlays for '${PLUGIN_NAME}' in '${SITE_NAME}' — running Composer only."
    echo ""
    _run_composer
    exit $?
fi

# Overlay mounts exist for this plugin+site; restore them if Composer is interrupted.
trap '_abort' ERR INT TERM

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo "[tcomposer] PHP        : ${PHP_CONTAINER}"
echo "[tcomposer] Operation  : ${OPERATION}"
echo "[tcomposer] Package    : ${PACKAGE}"
echo "[tcomposer] Site       : ${SITE_NAME}"
echo ""

# ── Step 1: Disable overlays and recreate containers ─────────────────────────
_comment_overlays
_recreate_containers
echo ""

# ── Step 2: Run Composer ──────────────────────────────────────────────────────
_run_composer
echo ""

# ── Step 3: Restore overlays (require/update only; leave disabled for remove) ─
if [[ "$OPERATION" == "remove" ]]; then
    echo "[tcomposer] Package removed."
    echo "[tcomposer] Overlay lines left disabled in: ${OVERLAY_FILE}"
    echo "[tcomposer] Delete them manually when no longer needed."
else
    _restore_overlays
    _recreate_containers
fi

trap - ERR INT TERM
echo ""
echo "[tcomposer] Done."
